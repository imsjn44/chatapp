FROM node:22-alpine

WORKDIR /app

COPY package*.json ./

RUN npm install --legacy-peer-deps

COPY . .

ARG USER_SERVICE
ARG CHAT_SERVICE
ARG FRONTEND_URL

ENV USER_SERVICE=$USER_SERVICE
ENV CHAT_SERVICE=$CHAT_SERVICE
ENV FRONTEND_URL=$FRONTEND_URL

RUN npm run build

EXPOSE 5002

CMD ["npm", "start"]
